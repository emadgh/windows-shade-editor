+fn snapshot_row_with_actions(
+    ui: &mut egui::Ui,
+    selected: bool,
+    dirty: bool,
+    label: &str,
+    time: &str,
+    exported: bool,
+    can_export: bool,
+) -> (egui::Response, bool, bool) {
+    let row_height = 31.0;
+    let desired = egui::vec2(ui.available_width().max(80.0), row_height);
+    let (rect, response) = ui.allocate_exact_size(desired, egui::Sense::click());
+    let visuals = ui.visuals();
+    let fill = if selected {
+        visuals.selection.bg_fill
+    } else if response.hovered() {
+        visuals.widgets.hovered.bg_fill
+    } else {
+        egui::Color32::TRANSPARENT
+    };
+    ui.painter().rect_filled(rect, 4.0, fill);
+    let icon_width = 23.0;
+    let gap = 3.0;
+    let right_padding = 3.0;
+    let mut right = rect.right() - right_padding;
+    let action_size = egui::vec2(icon_width, 22.0);
+    let mut export_clicked = false;
+    let mut folder_clicked = false;
+    if exported {
+        let action_rect = egui::Rect::from_min_size(
+            egui::pos2(right - icon_width, rect.center().y - action_size.y / 2.0),
+            action_size,
+        );
+        folder_clicked = ui
+            .put(action_rect, VectorIconButton::check())
+            .on_hover_text("Exported - open folder")
+            .clicked();
+        right -= icon_width + gap;
+    }
+    let action_rect = egui::Rect::from_min_size(
+        egui::pos2(right - icon_width, rect.center().y - action_size.y / 2.0),
+        action_size,
+    );
+    export_clicked = ui
+        .put(
+            action_rect,
+            VectorIconButton::export().enabled(can_export),
+        )
+        .on_hover_text("Export this Snapshot")
+        .clicked();
+    right -= icon_width + gap;
+
+    let text_left = rect.left() + 8.0;
+    let time_width = 42.0;
+    let time_left = (right - time_width).max(text_left + 24.0);
+    let label_rect = egui::Rect::from_min_max(
+        egui::pos2(text_left, rect.top()),
+        egui::pos2(time_left - 4.0, rect.bottom()),
+    );
+    let time_rect = egui::Rect::from_min_max(
+        egui::pos2(time_left, rect.top()),
+        egui::pos2(right, rect.bottom()),
+    );
+    let mut label_text = egui::RichText::new(label).size(13.0);
+    if selected {
+        label_text = label_text.strong();
+    }
+    if dirty {
+        label_text = label_text.color(egui::Color32::from_rgb(240, 185, 75));
+    }
+    ui.put(label_rect, egui::Label::new(label_text).truncate());
+    ui.put(
+        time_rect,
+        egui::Label::new(egui::RichText::new(time).small().weak()).truncate(),
+    );
+    (response, export_clicked, folder_clicked)
+}
