+fn clickable_channel_row(
+    ui: &mut egui::Ui,
+    selected: bool,
+    solo: bool,
+    label: &str,
+    accent: egui::Color32,
+    warning: Option<egui::Color32>,
+    height: f32,
+) -> egui::Response {
+    let desired = egui::vec2(ui.available_width().max(80.0), height);
+    let (rect, response) = ui.allocate_exact_size(desired, egui::Sense::click());
+    let visuals = ui.visuals();
+    let fill = if selected {
+        accent.gamma_multiply(0.28)
+    } else if response.hovered() {
+        visuals.widgets.hovered.bg_fill
+    } else {
+        egui::Color32::TRANSPARENT
+    };
+    ui.painter().rect_filled(rect, 4.0, fill);
+    ui.painter().rect_filled(
+        egui::Rect::from_min_max(rect.left_top(), egui::pos2(rect.left() + 4.0, rect.bottom())),
+        2.0,
+        accent,
+    );
+    let dot_center = egui::pos2(rect.left() + 14.0, rect.center().y);
+    ui.painter().circle_filled(dot_center, 4.0, accent);
+    let mut label_text = egui::RichText::new(label).color(if selected {
+        accent
+    } else {
+        visuals.text_color()
+    });
+    if selected {
+        label_text = label_text.strong();
+    }
+    let right_reserved = if warning.is_some() { 54.0 } else { 34.0 };
+    let label_rect = egui::Rect::from_min_max(
+        egui::pos2(rect.left() + 24.0, rect.top()),
+        egui::pos2(rect.right() - right_reserved, rect.bottom()),
+    );
+    ui.put(label_rect, egui::Label::new(label_text).truncate());
+    if solo {
+        let solo_rect = egui::Rect::from_min_max(
+            egui::pos2(rect.right() - 28.0, rect.top()),
+            egui::pos2(rect.right() - 5.0, rect.bottom()),
+        );
+        ui.put(
+            solo_rect,
+            egui::Label::new(egui::RichText::new("S").strong().color(accent)),
+        );
+    }
+    if let Some(warning) = warning {
+        ui.painter().circle_filled(egui::pos2(rect.right() - 39.0, rect.center().y), 4.0, warning);
+    }
+    response
+}
