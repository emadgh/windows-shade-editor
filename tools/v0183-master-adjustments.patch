+fn with_accent<R>(ui: &mut egui::Ui, accent: Option<egui::Color32>, body: impl FnOnce(&mut egui::Ui) -> R) -> R {
+    if let Some(accent) = accent {
+        ui.scope(|ui| {
+            ui.visuals_mut().selection.stroke.color = accent;
+            ui.visuals_mut().widgets.active.bg_fill = accent.gamma_multiply(0.55);
+            ui.visuals_mut().widgets.hovered.bg_fill = accent.gamma_multiply(0.26);
+            body(ui)
+        })
+        .inner
+    } else {
+        body(ui)
+    }
+}
+
+fn curve_editor_graph(
+    ui: &mut egui::Ui,
+    curve: &mut model::Curve,
+    histogram_before: Option<&[u32; 256]>,
+    histogram_after: Option<&[u32; 256]>,
+    accent: Option<egui::Color32>,
+    neutral_histogram: bool,
+) -> (bool, CurvePoint) {
+    let desired = egui::vec2(ui.available_width().max(120.0), 220.0);
+    let (rect, response) = ui.allocate_exact_size(desired, egui::Sense::click_and_drag());
+    let painter = ui.painter_at(rect);
+    let bg = ui.visuals().extreme_bg_color;
+    painter.rect_filled(rect, 5.0, bg);
+    painter.rect_stroke(
+        rect,
+        5.0,
+        ui.visuals().widgets.noninteractive.bg_stroke,
+        egui::StrokeKind::Inside,
+    );
+
+    let grid = ui.visuals().widgets.noninteractive.fg_stroke.color.gamma_multiply(0.18);
+    for step in 1..4 {
+        let t = step as f32 / 4.0;
+        let x = egui::lerp(rect.x_range(), t);
+        let y = egui::lerp(rect.y_range(), t);
+        painter.line_segment(
+            [egui::pos2(x, rect.top()), egui::pos2(x, rect.bottom())],
+            egui::Stroke::new(1.0, grid),
+        );
+        painter.line_segment(
+            [egui::pos2(rect.left(), y), egui::pos2(rect.right(), y)],
+            egui::Stroke::new(1.0, grid),
+        );
+    }
+
+    let histogram_max = histogram_before
+        .into_iter()
+        .flat_map(|bins| bins.iter())
+        .chain(histogram_after.into_iter().flat_map(|bins| bins.iter()))
+        .copied()
+        .max()
+        .unwrap_or(1)
+        .max(1) as f32;
+    if let Some(bins) = histogram_before {
+        let color = ui.visuals().weak_text_color().gamma_multiply(0.34);
+        for (index, value) in bins.iter().enumerate() {
+            let x = egui::lerp(rect.x_range(), index as f32 / 255.0);
+            let h = *value as f32 / histogram_max * rect.height();
+            painter.line_segment(
+                [egui::pos2(x, rect.bottom()), egui::pos2(x, rect.bottom() - h)],
+                egui::Stroke::new(1.0, color),
+            );
+        }
+    }
+    if let Some(bins) = histogram_after {
+        let color = if neutral_histogram {
+            ui.visuals().text_color().gamma_multiply(0.38)
+        } else {
+            accent
+                .unwrap_or(ui.visuals().selection.stroke.color)
+                .gamma_multiply(0.38)
+        };
+        for (index, value) in bins.iter().enumerate() {
+            let x = egui::lerp(rect.x_range(), index as f32 / 255.0);
+            let h = *value as f32 / histogram_max * rect.height();
+            painter.line_segment(
+                [egui::pos2(x, rect.bottom()), egui::pos2(x, rect.bottom() - h)],
+                egui::Stroke::new(1.0, color),
+            );
+        }
+    }
+
+    let curve_color = accent.unwrap_or(ui.visuals().selection.stroke.color);
+    let mut points = Vec::with_capacity(3);
+    points.push((CurvePoint::Black, curve.input_black, curve.black));
+    if curve.midpoint_enabled {
+        points.push((CurvePoint::Mid, curve.midpoint_input, curve.midpoint));
+    }
+    points.push((CurvePoint::White, curve.input_white, curve.white));
+
+    let to_screen = |x: f32, y: f32| {
+        egui::pos2(
+            egui::lerp(rect.x_range(), x.clamp(0.0, 1.0)),
+            egui::lerp(rect.y_range(), 1.0 - y.clamp(0.0, 1.0)),
+        )
+    };
+    let sample_count = 128;
+    let mut polyline = Vec::with_capacity(sample_count + 1);
+    for index in 0..=sample_count {
+        let input = index as f32 / sample_count as f32;
+        let output = model::apply_curve(input, *curve);
+        polyline.push(to_screen(input, output));
+    }
+    painter.add(egui::Shape::line(polyline, egui::Stroke::new(2.0, curve_color)));
+
+    let focus_id = egui::Id::new("shade-editor-curve-graph-focused");
+    let selection_id = response.id.with("curve-point-selection");
+    let mut selected = ui
+        .ctx()
+        .data(|data| data.get_temp::<CurvePoint>(selection_id))
+        .unwrap_or(CurvePoint::Mid);
+    if !curve.midpoint_enabled && selected == CurvePoint::Mid {
+        selected = CurvePoint::Black;
+    }
+
+    let pointer = response.interact_pointer_pos();
+    let mut changed = false;
+    if response.clicked() || response.drag_started() {
+        ui.ctx().data_mut(|data| data.insert_temp(focus_id, true));
+        if let Some(pointer) = pointer {
+            let mut nearest = None;
+            for (point, x, y) in &points {
+                let distance = to_screen(*x, *y).distance(pointer);
+                if distance <= 16.0 && nearest.map(|(_, best)| distance < best).unwrap_or(true) {
+                    nearest = Some((*point, distance));
+                }
+            }
+            if let Some((point, _)) = nearest {
+                selected = point;
+                ui.ctx().data_mut(|data| data.insert_temp(selection_id, selected));
+            }
+        }
+    }
+
+    if response.double_clicked() {
+        if let Some(pointer) = pointer {
+            let midpoint_screen = to_screen(curve.midpoint_input, curve.midpoint);
+            if curve.midpoint_enabled && midpoint_screen.distance(pointer) <= 18.0 {
+                curve.midpoint_enabled = false;
+                selected = CurvePoint::Black;
+                changed = true;
+            } else {
+                let x = ((pointer.x - rect.left()) / rect.width()).clamp(0.0, 1.0);
+                let y = (1.0 - (pointer.y - rect.top()) / rect.height()).clamp(0.0, 1.0);
+                curve.midpoint_enabled = true;
+                curve.midpoint_input = x.clamp(curve.input_black + 0.001, curve.input_white - 0.001);
+                curve.midpoint = y;
+                selected = CurvePoint::Mid;
+                changed = true;
+            }
+            ui.ctx().data_mut(|data| data.insert_temp(selection_id, selected));
+        }
+    } else if response.dragged() {
+        if let Some(pointer) = pointer {
+            let x = ((pointer.x - rect.left()) / rect.width()).clamp(0.0, 1.0);
+            let y = (1.0 - (pointer.y - rect.top()) / rect.height()).clamp(0.0, 1.0);
+            set_curve_point(curve, selected, x, y);
+            changed = true;
+        }
+    }
+
+    if response.clicked_elsewhere() && !response.dragged() {
+        ui.ctx().data_mut(|data| data.insert_temp(focus_id, false));
+    }
+
+    for (point, x, y) in points {
+        let center = to_screen(x, y);
+        let radius = if selected == point { 6.5 } else { 5.0 };
+        painter.circle_filled(center, radius, if selected == point { curve_color } else { bg });
+        painter.circle_stroke(center, radius, egui::Stroke::new(2.0, curve_color));
+    }
+
+    if ui.ctx().data(|data| data.get_temp::<bool>(focus_id).unwrap_or(false)) {
+        let (left, right, up, down, large) = ui.input(|input| {
+            (
+                input.key_pressed(egui::Key::ArrowLeft),
+                input.key_pressed(egui::Key::ArrowRight),
+                input.key_pressed(egui::Key::ArrowUp),
+                input.key_pressed(egui::Key::ArrowDown),
+                input.modifiers.shift,
+            )
+        });
+        let step = if large { 10.0 / 255.0 } else { 1.0 / 255.0 };
+        let (mut x, mut y) = curve_point_values(curve, selected);
+        if left {
+            x -= step;
+        }
+        if right {
+            x += step;
+        }
+        if up {
+            y += step;
+        }
+        if down {
+            y -= step;
+        }
+        if left || right || up || down {
+            set_curve_point(curve, selected, x, y);
+            changed = true;
+        }
+    }
+
+    (changed, selected)
+}
+
+fn curve_point_values(curve: &model::Curve, point: CurvePoint) -> (f32, f32) {
+    match point {
+        CurvePoint::Black => (curve.input_black, curve.black),
+        CurvePoint::Mid => (curve.midpoint_input, curve.midpoint),
+        CurvePoint::White => (curve.input_white, curve.white),
+    }
+}
+
+fn set_curve_point(curve: &mut model::Curve, point: CurvePoint, x: f32, y: f32) {
+    match point {
+        CurvePoint::Black => {
+            let upper = if curve.midpoint_enabled {
+                curve.midpoint_input - 0.001
+            } else {
+                curve.input_white - 0.001
+            };
+            curve.input_black = x.clamp(0.0, upper.max(0.0));
+            curve.black = y.clamp(0.0, 1.0);
+        }
+        CurvePoint::Mid => {
+            if curve.midpoint_enabled {
+                curve.midpoint_input = x.clamp(curve.input_black + 0.001, curve.input_white - 0.001);
+                curve.midpoint = y.clamp(0.0, 1.0);
+            }
+        }
+        CurvePoint::White => {
+            let lower = if curve.midpoint_enabled {
+                curve.midpoint_input + 0.001
+            } else {
+                curve.input_black + 0.001
+            };
+            curve.input_white = x.clamp(lower.min(1.0), 1.0);
+            curve.white = y.clamp(0.0, 1.0);
+        }
+    }
+}
+
+fn curve_point_fields(ui: &mut egui::Ui, curve: &mut model::Curve, selected: CurvePoint) -> bool {
+    let (x, y) = curve_point_values(curve, selected);
+    let mut input_value = (x * 255.0).round() as i32;
+    let mut output_value = (y * 255.0).round() as i32;
+    let mut input_changed = false;
+    let mut output_changed = false;
+    ui.columns(2, |columns| {
+        columns[0].label("Input");
+        input_changed = columns[0]
+            .add(
+                egui::DragValue::new(&mut input_value)
+                    .range(0..=255)
+                    .speed(1),
+            )
+            .changed();
+        columns[1].label("Output");
+        output_changed = columns[1]
+            .add(
+                egui::DragValue::new(&mut output_value)
+                    .range(0..=255)
+                    .speed(1),
+            )
+            .changed();
+    });
+    if input_changed || output_changed {
+        set_curve_point(
+            curve,
+            selected,
+            input_value as f32 / 255.0,
+            output_value as f32 / 255.0,
+        );
+        true
+    } else {
+        false
+    }
+}
+
+fn curves_ui(
+    ui: &mut egui::Ui,
+    adjustment: &mut ChannelAdjustment,
+    histogram_before: Option<&[u32; 256]>,
+    histogram_after: Option<&[u32; 256]>,
+    accent: Option<egui::Color32>,
+    compact_controls: bool,
+    neutral_histogram: bool,
+) -> bool {
+    with_accent(ui, accent, |ui| {
+        let (graph_changed, selected) = curve_editor_graph(
+            ui,
+            &mut adjustment.curve,
+            histogram_before,
+            histogram_after,
+            accent,
+            neutral_histogram,
+        );
+        if histogram_before.is_some() && histogram_after.is_some() {
+            ui.horizontal(|ui| {
+                ui.colored_label(ui.visuals().weak_text_color(), "Before");
+                let after_color = if neutral_histogram {
+                    ui.visuals().weak_text_color()
+                } else {
+                    accent.unwrap_or(ui.visuals().selection.stroke.color)
+                };
+                ui.colored_label(after_color, "After");
+            });
+        }
+        let mut changed = graph_changed;
+        if !compact_controls {
+            ui.add_space(6.0);
+            changed |= curve_point_fields(ui, &mut adjustment.curve, selected);
+            ui.add_space(4.0);
+            ui.small("Double-click the Curve line to add the midpoint; double-click the midpoint to remove it. Drag active points directly. Input / Output use Photoshop-style 0-255 values.");
+        }
+        changed
+    })
+}
+
+fn master_levels_ui(
+    ui: &mut egui::Ui,
+    adjustments: &mut BTreeMap<String, ChannelAdjustment>,
+) -> bool {
+    let mut draft = adjustments
+        .get(MASTER_ADJUSTMENT_KEY)
+        .cloned()
+        .unwrap_or_default();
+    if !levels_ui(ui, &mut draft, None) {
+        return false;
+    }
+    adjustments
+        .entry(MASTER_ADJUSTMENT_KEY.to_owned())
+        .or_default()
+        .levels = draft.levels;
+    cleanup_master_adjustment(adjustments);
+    true
+}
+
+fn master_curve_ui(
+    ui: &mut egui::Ui,
+    adjustments: &mut BTreeMap<String, ChannelAdjustment>,
+    histogram_before: Option<&[u32; 256]>,
+    histogram_after: Option<&[u32; 256]>,
+    compact_controls: bool,
+) -> bool {
+    let mut draft = adjustments
+        .get(MASTER_ADJUSTMENT_KEY)
+        .cloned()
+        .unwrap_or_default();
+    if !curves_ui(
+        ui,
+        &mut draft,
+        histogram_before,
+        histogram_after,
+        None,
+        compact_controls,
+        true,
+    ) {
+        return false;
+    }
+    adjustments
+        .entry(MASTER_ADJUSTMENT_KEY.to_owned())
+        .or_default()
+        .curve = draft.curve;
+    cleanup_master_adjustment(adjustments);
+    true
+}
+
+fn aggregate_histograms(histograms: &[[u32; 256]]) -> [u32; 256] {
+    let mut aggregate = [0u32; 256];
+    for histogram in histograms {
+        for (target, value) in aggregate.iter_mut().zip(histogram.iter()) {
+            *target = target.saturating_add(*value);
+        }
+    }
+    aggregate
+}
+
+fn all_mixers_ui(
+    ui: &mut egui::Ui,
+    adjustments: &mut BTreeMap<String, ChannelAdjustment>,
+    channel_names: &[String],
+    colorize: bool,
+    palette: Option<&ChannelPalette>,
+) -> bool {
+    let mut changed = false;
+    for (index, output_name) in channel_names.iter().enumerate() {
+        let accent = colorize.then(|| channel_color(palette, output_name, index));
+        let title = if let Some(color) = accent {
+            egui::RichText::new(format!("●  {}", channel_display_name(palette, output_name, index)))
+                .color(color)
+        } else {
+            egui::RichText::new(channel_display_name(palette, output_name, index))
+        };
+        egui::CollapsingHeader::new(title)
+            .id_salt(format!("all-mixer-{index}-{output_name}"))
+            .default_open(index == 0)
+            .show(ui, |ui| {
+                let adjustment = adjustments.entry(output_name.clone()).or_default();
+                changed |= mixer_ui(ui, adjustment, output_name, channel_names, accent, palette);
+            });
+    }
+    changed
+}
