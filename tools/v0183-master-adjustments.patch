+fn format_bytes(bytes: u64) -> String {
+    const KB: f64 = 1024.0;
+    const MB: f64 = KB * 1024.0;
+    const GB: f64 = MB * 1024.0;
+    let value = bytes as f64;
+    if value >= GB {
+        format!("{:.2} GiB", value / GB)
+    } else if value >= MB {
+        format!("{:.1} MiB", value / MB)
+    } else if value >= KB {
+        format!("{:.1} KiB", value / KB)
+    } else {
+        format!("{bytes} B")
+    }
+}
+
+fn physical_dimensions_cm(width: u32, height: u32, dpi: dpi::DpiInfo) -> (f64, f64) {
+    let safe_x = dpi.x.max(1.0);
+    let safe_y = dpi.y.max(1.0);
+    (
+        width as f64 / safe_x * 2.54,
+        height as f64 / safe_y * 2.54,
+    )
+}
