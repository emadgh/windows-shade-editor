+fn reveal_in_explorer(path: &Path) -> Result<(), String> {
+    #[cfg(target_os = "windows")]
+    {
+        if path.is_file() {
+            std::process::Command::new("explorer.exe")
+                .arg("/select,")
+                .arg(path)
+                .spawn()
+                .map_err(|err| format!("Cannot reveal {} in Explorer: {err}", path.display()))?;
+            return Ok(());
+        }
+    }
+    let folder = path.parent().unwrap_or(path);
+    open_folder(folder)
+}
+
+fn open_folder(path: &Path) -> Result<(), String> {
+    #[cfg(target_os = "windows")]
+    {
+        std::process::Command::new("explorer.exe")
+            .arg(path)
+            .spawn()
+            .map_err(|err| format!("Cannot open {}: {err}", path.display()))?;
+        return Ok(());
+    }
+    #[allow(unreachable_code)]
+    Err("Open folder is only supported on Windows.".to_owned())
+}
+
+fn snapshot_day_time(value: i64) -> (String, String) {
+    let local = Local
+        .timestamp_millis_opt(value)
+        .single()
+        .unwrap_or_else(Local::now);
+    (
+        local.format("%Y-%m-%d").to_string(),
+        local.format("%H:%M").to_string(),
+    )
+}
