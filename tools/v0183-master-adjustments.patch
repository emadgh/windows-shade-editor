+fn channel_display_name<'a>(
+    palette: Option<&'a ChannelPalette>,
+    name: &'a str,
+    index: usize,
+) -> &'a str {
+    palette
+        .and_then(|palette| palette.display_name(index, name))
+        .unwrap_or(name)
+}
+
+fn fallback_channel_color(name: &str) -> egui::Color32 {
+    match name.to_ascii_lowercase().as_str() {
+        "cyan" | "c" => egui::Color32::from_rgb(0, 180, 215),
+        "magenta" | "m" => egui::Color32::from_rgb(220, 55, 160),
+        "yellow" | "y" => egui::Color32::from_rgb(225, 185, 35),
+        "black" | "k" => egui::Color32::from_rgb(130, 130, 130),
+        "red" | "r" => egui::Color32::from_rgb(225, 75, 75),
+        "green" | "g" => egui::Color32::from_rgb(70, 185, 105),
+        "blue" | "b" => egui::Color32::from_rgb(70, 115, 225),
+        _ => {
+            const COLORS: [[u8; 3]; 8] = [
+                [55, 200, 145],
+                [235, 110, 70],
+                [115, 105, 230],
+                [225, 95, 185],
+                [100, 180, 230],
+                [185, 145, 60],
+                [95, 195, 205],
+                [175, 100, 215],
+            ];
+            let hash = name.bytes().fold(0usize, |acc, value| {
+                acc.wrapping_mul(31).wrapping_add(value as usize)
+            });
+            let rgb = COLORS[hash % COLORS.len()];
+            egui::Color32::from_rgb(rgb[0], rgb[1], rgb[2])
+        }
+    }
+}
+
+fn draw_histogram(
+    ui: &mut egui::Ui,
+    original: Option<&[u32; 256]>,
+    adjusted: Option<&[u32; 256]>,
+    accent: Option<egui::Color32>,
+) {
+    let desired = egui::vec2(ui.available_width().max(80.0), 105.0);
+    let (rect, _) = ui.allocate_exact_size(desired, egui::Sense::hover());
+    let painter = ui.painter_at(rect);
+    painter.rect_filled(rect, 4.0, ui.visuals().extreme_bg_color);
+    painter.rect_stroke(
+        rect,
+        4.0,
+        ui.visuals().widgets.noninteractive.bg_stroke,
+        egui::StrokeKind::Inside,
+    );
+    let max_value = original
+        .into_iter()
+        .flat_map(|bins| bins.iter())
+        .chain(adjusted.into_iter().flat_map(|bins| bins.iter()))
+        .copied()
+        .max()
+        .unwrap_or(1)
+        .max(1) as f32;
+    let original_color = ui.visuals().weak_text_color();
+    let adjusted_color = accent.unwrap_or(ui.visuals().selection.stroke.color);
+    for index in 0..256 {
+        let x = egui::lerp(rect.x_range(), index as f32 / 255.0);
+        if let Some(bins) = original {
+            let h = bins[index] as f32 / max_value * rect.height();
+            painter.line_segment(
+                [
+                    egui::pos2(x, rect.bottom()),
+                    egui::pos2(x, rect.bottom() - h),
+                ],
+                egui::Stroke::new(1.0, original_color),
+            );
+        }
+        if let Some(bins) = adjusted {
+            let h = bins[index] as f32 / max_value * rect.height();
+            painter.line_segment(
+                [
+                    egui::pos2(x, rect.bottom()),
+                    egui::pos2(x, rect.bottom() - h),
+                ],
+                egui::Stroke::new(1.0, adjusted_color),
+            );
+        }
+    }
+}
