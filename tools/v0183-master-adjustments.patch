+fn channel_color(
+    palette: Option<&ChannelPalette>,
+    name: &str,
+    index: usize,
+) -> egui::Color32 {
+    if let Some(entry) = palette.and_then(|palette| palette.entry(index, name)) {
+        return egui::Color32::from_rgb(entry.color_rgb[0], entry.color_rgb[1], entry.color_rgb[2]);
+    }
+    fallback_channel_color(name)
+}
+
+fn channel_color_with_photoshop(
+    palette: Option<&ChannelPalette>,
+    display: &[Option<tiff_io::PhotoshopChannelDisplay>],
+    name: &str,
+    index: usize,
+) -> egui::Color32 {
+    if let Some(entry) = palette.and_then(|palette| palette.entry(index, name)) {
+        return egui::Color32::from_rgb(entry.color_rgb[0], entry.color_rgb[1], entry.color_rgb[2]);
+    }
+    if let Some(rgb) = display
+        .get(index)
+        .and_then(|value| *value)
+        .and_then(|value| value.rgb)
+    {
+        return egui::Color32::from_rgb(
+            (rgb[0].clamp(0.0, 1.0) * 255.0).round() as u8,
+            (rgb[1].clamp(0.0, 1.0) * 255.0).round() as u8,
+            (rgb[2].clamp(0.0, 1.0) * 255.0).round() as u8,
+        );
+    }
+    fallback_channel_color(name)
+}
