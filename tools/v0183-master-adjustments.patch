+fn clickable_row(
+    ui: &mut egui::Ui,
+    selected: bool,
+    label: &str,
+    trailing: Option<&str>,
+    accent: Option<egui::Color32>,
+    height: f32,
+) -> egui::Response {
+    let desired = egui::vec2(ui.available_width().max(80.0), height);
+    let (rect, response) = ui.allocate_exact_size(desired, egui::Sense::click());
+    let visuals = ui.visuals();
+    let fill = if selected {
+        visuals.selection.bg_fill
+    } else if response.hovered() {
+        visuals.widgets.hovered.bg_fill
+    } else {
+        egui::Color32::TRANSPARENT
+    };
+    ui.painter().rect_filled(rect, 4.0, fill);
+    if let Some(accent) = accent {
+        ui.painter().rect_filled(
+            egui::Rect::from_min_max(
+                rect.left_top(),
+                egui::pos2(rect.left() + 3.0, rect.bottom()),
+            ),
+            1.0,
+            accent,
+        );
+    }
+    let text_color = if selected {
+        visuals.selection.stroke.color
+    } else {
+        visuals.text_color()
+    };
+    let text_left = rect.left() + if accent.is_some() { 9.0 } else { 7.0 };
+    let trailing_width = trailing.map(|_| 92.0).unwrap_or(0.0);
+    let label_rect = egui::Rect::from_min_max(
+        egui::pos2(text_left, rect.top()),
+        egui::pos2((rect.right() - trailing_width - 5.0).max(text_left), rect.bottom()),
+    );
+    let mut label_text = egui::RichText::new(label).color(text_color);
+    if selected {
+        label_text = label_text.strong();
+    }
+    ui.put(label_rect, egui::Label::new(label_text).truncate());
+    if let Some(trailing) = trailing {
+        let trailing_rect = egui::Rect::from_min_max(
+            egui::pos2(rect.right() - trailing_width, rect.top()),
+            egui::pos2(rect.right() - 7.0, rect.bottom()),
+        );
+        ui.put(
+            trailing_rect,
+            egui::Label::new(egui::RichText::new(trailing).weak().small()).truncate(),
+        );
+    }
+    response
+}
